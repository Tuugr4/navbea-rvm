[Unit]
Description=Navbea RVM Service
After=local-fs.target

[Service]
Type=simple
User=navbea-rvm
Group=navbea-media
RuntimeDirectory=navbea
RuntimeDirectoryMode=0750
StateDirectory=navbea/rvm
ExecStart=/opt/navbea/rvm/node /opt/navbea/rvm/service/main.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/navbea/rvm /run/navbea

[Install]
WantedBy=multi-user.target
